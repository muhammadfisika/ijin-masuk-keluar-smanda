      'wakaSearch'
    ).value
      .trim()
      .toLowerCase();

  const status =
    document.getElementById(
      'wakaStatusFilter'
    ).value;

  const filtered =
    wakaData.filter(function(item) {

      const cocokKeyword =
        !keyword ||

        String(item.nama)
          .toLowerCase()
          .includes(keyword) ||

        String(item.kelas)
          .toLowerCase()
          .includes(keyword) ||

        String(item.nisn)
          .toLowerCase()
          .includes(keyword);

      const cocokStatus =
        status === 'SEMUA' ||
        item.status === status;

      return cocokKeyword &&
             cocokStatus;

    });

