/* ======================================================
   WALI - SIMPAN
====================================================== */

function simpanIzin() {

  if (!currentUser) {

    showToast(
      'Silakan login terlebih dahulu.',
      'error'
    );

    return;
  }

  const tanggal =
    document.getElementById(
      'izinTanggal'
    ).value;

  const nisn =
    document.getElementById(
      'izinSiswa'
    ).value;

  const jenisIzin =
    document.getElementById(
      'izinJenis'
    ).value;

  const alasan =
    document.getElementById(
      'izinAlasan'
    ).value.trim();

  const waktuKeluar =
    document.getElementById(
      'izinWaktuKeluar'
    ).value;

  const waktuKembali =
    document.getElementById(
      'izinWaktuKembali'
    ).value;

  if (
    !tanggal ||
    !nisn ||
    !jenisIzin ||
    !alasan
  ) {

    showToast(
      'Lengkapi data izin terlebih dahulu.',
      'error'
    );

    return;
  }

  if (
    waktuKeluar &&
    waktuKembali &&
    waktuKembali <= waktuKeluar
  ) {

    showToast(
      'Waktu kembali harus lebih besar dari waktu keluar.',
      'error'
    );

    return;
  }

  const data = {

    username:
      currentUser.username,

    tanggal:
      tanggal,

    nisn:
      nisn,

    jenisIzin:
      jenisIzin,

    alasan:
      alasan,

    waktuKeluar:
      waktuKeluar,

    waktuKembali:
      waktuKembali

  };

  showLoading(true);

  google.script.run
    .withSuccessHandler(function(result) {

      showLoading(false);

      if (!result.success) {

        showToast(
          result.message,
          'error'
        );

        return;
      }

      showToast(
        result.message,
        'success'
      );

      document.getElementById(
        'izinSiswa'
      ).value = '';

      document.getElementById(
        'izinAlasan'
      ).value = '';

      document.getElementById(
        'izinWaktuKeluar'
      ).value = '';

      document.getElementById(
        'izinWaktuKembali'
      ).value = '';

      loadWaliHistory();

    })
    .withFailureHandler(function(error) {

      showLoading(false);

      showToast(
        error.message ||
        'Gagal menyimpan izin.',
        'error'
      );

    })
    .simpanIzin(data);

}


