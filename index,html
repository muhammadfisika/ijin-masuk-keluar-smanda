}


/* ======================================================
   APPROVE
====================================================== */

function approveIzin(id) {

  if (!currentUser) {
    return;
  }

  if (
    !confirm(
      'Apakah Anda yakin ingin menyetujui pengajuan ini?'
    )
  ) {
    return;
  }

  showLoading(true);

  google.script.run
    .withSuccessHandler(function(result) {

      showLoading(false);

      if (!result.success) {

        showToast(
          result.message,
          'error'
        );

        return;
      }

      showToast(
        result.message,
        'success'
      );

      loadWakaData();

    })
    .withFailureHandler(function(error) {

      showLoading(false);

      showToast(
        error.message ||
        'Gagal menyetujui pengajuan.',
        'error'
      );

    })
    .approveIzin(
      id,
      currentUser.username
    );

}


/* ======================================================
   REJECT
====================================================== */

function openRejectModal(id) {

  rejectId = id;

  document.getElementById(
    'rejectReason'
  ).value = '';

  document.getElementById(
    'rejectModal'
  ).classList.add('show');

}


function closeRejectModal() {

  rejectId = '';

  document.getElementById(
    'rejectModal'
  ).classList.remove('show');

}


function confirmReject() {

  if (!rejectId) {
    return;
  }

  const alasan =
    document.getElementById(
      'rejectReason'
    ).value.trim();

  if (!alasan) {

    showToast(
      'Alasan penolakan wajib diisi.',
      'error'
    );

    return;
  }

  showLoading(true);

  google.script.run
    .withSuccessHandler(function(result) {

      showLoading(false);

      closeRejectModal();

      if (!result.success) {

        showToast(
          result.message,
          'error'
        );

        return;
      }

      showToast(
        result.message,
        'success'
      );

      loadWakaData();

    })
    .withFailureHandler(function(error) {

      showLoading(false);

      showToast(
        error.message ||
        'Gagal menolak pengajuan.',
        'error'
      );

    })
    .tolakIzin(
      rejectId,
      currentUser.username,
      alasan
    );

}


/* ======================================================
   BADGE
====================================================== */

function statusBadge(status) {

  status =
    String(status || '')
      .toUpperCase();

  if (status === 'DIAJUKAN') {

    return (
      '<span class="badge badge-warning">' +
      'DIAJUKAN' +
      '</span>'
    );

  }

  if (status === 'DISETUJUI') {

    return (
      '<span class="badge badge-success">' +
      'DISETUJUI' +
      '</span>'
    );

  }

  if (status === 'DITOLAK') {

    return (
      '<span class="badge badge-danger">' +
      'DITOLAK' +
      '</span>'
    );

  }

  return (
    '<span class="badge badge-blue">' +
    escapeHtml(status) +
    '</span>'
  );

}


function jenisBadge(jenis) {

  jenis =
    String(jenis || '')
      .toUpperCase();

  if (jenis === 'KELUAR') {

    return (
      '<span class="badge badge-danger">' +
      'KELUAR' +
      '</span>'
    );

  }

  if (jenis === 'MASUK') {

    return (
      '<span class="badge badge-blue">' +
      'MASUK' +
      '</span>'
    );

  }

  return escapeHtml(jenis);

}


/* ======================================================
   SECURITY DISPLAY
====================================================== */

function escapeHtml(value) {

  if (
    value === null ||
    value === undefined
  ) {
    return '';
  }

  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');

}


function escapeJs(value) {

  if (
    value === null ||
    value === undefined
  ) {
    return '';
  }

  return String(value)
    .replace(/\\/g, '\\\\')
    .replace(/'/g, "\\'");
}


/* ======================================================
   UI
====================================================== */

function showLoading(show) {

  const element =
    document.getElementById(
      'loading'
    );

  if (show) {
    element.classList.add('show');
  } else {
    element.classList.remove('show');
  }

}


function showToast(
  message,
  type
) {

  const toast =
    document.getElementById(
      'toast'
    );

  toast.textContent =
    message || '';

  toast.className =
    'toast show ' +
    (type || '');

  setTimeout(function() {

    toast.classList.remove(
      'show'
    );

  }, 3500);

}

