}


function filterPublicTable() {

  const keyword =
    document.getElementById(
      'publicSearch'
    ).value
      .trim()
      .toLowerCase();

  if (!keyword) {

    renderPublicTable(publicData);

    return;
  }

  const filtered =
    publicData.filter(function(item) {

      return (
        String(item.nama)
          .toLowerCase()
          .includes(keyword) ||

        String(item.kelas)
          .toLowerCase()
          .includes(keyword) ||

        String(item.nisn)
          .toLowerCase()
          .includes(keyword)
      );

    });

  renderPublicTable(filtered);

}


