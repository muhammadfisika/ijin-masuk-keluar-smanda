function renderWaliTable(data) {

  const tbody =
    document.getElementById(
      'waliTable'
    );

  tbody.innerHTML = '';

  if (!data.length) {

    tbody.innerHTML =
      '<tr>' +
      '<td colspan="8" class="empty">' +
      'Belum ada pengajuan pada tanggal tersebut.' +
      '</td>' +
      '</tr>';

    return;
  }

  data.forEach(function(item, index) {

    const tr =
      document.createElement('tr');

    let keterangan = '-';

    if (
      item.status === 'DITOLAK'
    ) {

      keterangan =
        '<b>Ditolak oleh:</b> ' +
        escapeHtml(
          item.approver || '-'
        ) +
        '<br>' +
        '<b>Alasan:</b> ' +
        escapeHtml(
          item.keteranganApproval || '-'
        );

    } else if (
      item.status === 'DISETUJUI'
    ) {

      keterangan =
        '<b>Disetujui oleh:</b> ' +
        escapeHtml(
          item.approver || '-'
        );

    } else {

      keterangan =
        'Menunggu persetujuan Wakasek';

    }

    tr.innerHTML =

      '<td>' +
      (index + 1) +
      '</td>' +

      '<td><b>' +
      escapeHtml(item.nama) +
      '</b></td>' +

      '<td>' +
      escapeHtml(item.kelas) +
      '</td>' +

      '<td>' +
      jenisBadge(item.jenisIzin) +
      '</td>' +

      '<td>' +
      escapeHtml(item.alasan) +
      '</td>' +

      '<td>' +
      escapeHtml(
        item.waktuKeluar || '-'
      ) +
      ' - ' +
      escapeHtml(
        item.waktuKembali || '-'
      ) +
      '</td>' +

      '<td>' +
      statusBadge(item.status) +
      '</td>' +

      '<td>' +
      keterangan +
      '</td>';

    tbody.appendChild(tr);

  });

}


function filterWaliTable() {

  const keyword =
    document.getElementById(
      'waliSearch'
    ).value
      .trim()
      .toLowerCase();

  const status =
    document.getElementById(
      'waliStatusFilter'
    ).value;

  const filtered =
    waliData.filter(function(item) {

      const cocokKeyword =
        !keyword ||

        String(item.nama)
          .toLowerCase()
          .includes(keyword) ||

        String(item.kelas)
          .toLowerCase()
          .includes(keyword) ||

        String(item.nisn)
          .toLowerCase()
          .includes(keyword);

      const cocokStatus =
        status === 'SEMUA' ||
        item.status === status;

      return cocokKeyword &&
             cocokStatus;

    });

  renderWaliTable(filtered);

}


